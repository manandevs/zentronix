{
  "format": "custom",
  "id": "settings",
  "label": "Settings",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "site_title": {
        "type": "Text",
        "config": {
          "label": "Site Title",
          "placeholder": "Enter your site title..."
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Enter the default meta description for search engine results..."
        }
      },
      "favicon": {
        "type": "Image",
        "config": {
          "label": "Favicon",
          "constraint": {},
          "thumbnails": []
        }
      },
      "og_image": {
        "type": "Image",
        "config": {
          "label": "OG Image",
          "constraint": {
            "width": 1200,
            "height": 630
          },
          "thumbnails": []
        }
      },
      "navigation": {
        "type": "Group",
        "config": {
          "label": "Navigation",
          "repeat": true,
          "fields": {
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "placeholder": "Select or enter link destination...",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            },
            "label": {
              "type": "Text",
              "config": {
                "label": "Label",
                "placeholder": ""
              }
            }
          }
        }
      },
      "cta_button": {
        "type": "Group",
        "config": {
          "label": "CTA Button",
          "repeat": true,
          "fields": {
            "button_link": {
              "type": "Link",
              "config": {
                "label": "Button Link",
                "placeholder": "Select or enter link destination...",
                "select": null,
                "allowTargetBlank": true,
                "allowText": true,
                "repeat": false
              }
            },
            "button_label": {
              "type": "Text",
              "config": {
                "label": "Button Label",
                "placeholder": "Enter button text (e.g., Start Building)..."
              }
            }
          }
        }
      }
    }
  }
}
